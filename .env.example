# booking-truth configuration. Copy to .env (optional: `docker compose up` works without it) and edit.
# Every setting carries the BT_ prefix. An empty value counts as unset, so the built-in default applies.
# Every booking-truth command reads .env from the current directory, and docker compose passes it to the agent.
# A variable exported in the shell wins over .env, except an empty one, which counts as unset.
# docker-compose.yml pins the calendar and CRM settings to the bundled sandbox; the rest can be set here.
# Never commit .env: it is git-ignored.

# --- LLM (any OpenAI-compatible endpoint) -------------------------------------------------------------------

# Base URL of the chat-completions API.
BT_LLM_BASE_URL=https://openrouter.ai/api/v1
# API key. Empty: the agent runs its scripted offline demo policy and `test` grades offline.
# Outside Docker an empty value falls back to OPENROUTER_API_KEY; inside Docker it never does.
BT_LLM_API_KEY=
# Exact model id for the agent (ids ending in "latest" are rejected while the pinned_version guard is on).
# Empty: the default model named in the README.
BT_LLM_MODEL=
# Model id for LLM personas in `booking-truth test`. Empty: BT_LLM_MODEL.
BT_PERSONA_MODEL=
# Model id for the LLM belief extractor in `booking-truth test`. Empty: BT_LLM_MODEL.
BT_EXTRACTOR_MODEL=
# Upstream provider to pin through OpenRouter provider routing, with fallbacks disabled. Empty: no pinning.
BT_LLM_PROVIDER=

# --- Calendar -----------------------------------------------------------------------------------------------

# Calendar backend: calcom or google.
BT_CALENDAR=calcom
# Cal.com API base URL (the sandbox mirrors it at http://localhost:8100).
BT_CALCOM_BASE_URL=https://api.cal.com
# Cal.com API key (secret). For the sandbox, the sandbox token.
BT_CALCOM_API_KEY=
# Cal.com event type id to book into. Required for a real Cal.com account.
BT_CALCOM_EVENT_TYPE_ID=
# Google Calendar API base URL (the sandbox mirrors it at http://localhost:8100).
BT_GOOGLE_BASE_URL=https://www.googleapis.com
# OAuth token endpoint for the service-account flow.
BT_GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# Calendar id shared with the service account.
BT_GOOGLE_CALENDAR_ID=primary
# Path to the service-account JSON key file (secret; keep it outside the repository).
BT_GOOGLE_SERVICE_ACCOUNT_FILE=
# Event key for Google bookings, part of every idempotency key (Cal.com uses the event type id).
BT_EVENT_KEY=default
# Host time zone (IANA name) for working hours.
BT_HOST_TIMEZONE=America/New_York
# Working hours in the host zone, used to compute Google slots from freeBusy.
BT_WORK_HOURS=09:00-17:00
# Working days: a range (mon-fri, 1-5) or a list (mon,wed,fri).
BT_WORK_DAYS=mon-fri
# Meeting length in minutes.
BT_SLOT_MINUTES=30
# Minimum notice before the earliest bookable slot, in minutes.
BT_MIN_NOTICE_MINUTES=120
# How many days ahead slots are offered (docker-compose.yml uses 400, like the sandbox).
BT_HORIZON_DAYS=60

# --- CRM ----------------------------------------------------------------------------------------------------

# CRM backend: none or hubspot.
BT_CRM=none
# HubSpot service key or private-app token (secret). For the sandbox, the sandbox token.
BT_HUBSPOT_TOKEN=
# HubSpot API base URL (the sandbox mirrors it at http://localhost:8100).
BT_HUBSPOT_BASE_URL=https://api.hubapi.com

# --- Agent --------------------------------------------------------------------------------------------------

# Integrity guards: all, off (the naive baseline) or a comma list of guard names.
BT_GUARDS=all
# SQLite database for sessions, the claim ledger, idempotency keys, locks, the CRM outbox and hand-offs.
BT_DB_PATH=~/.local/state/booking-truth/agent.db
# Bearer key for POST /v1/chat and the other server-to-server endpoints. Change it for any real deployment.
BT_API_KEY=dev-local-key
# Comma-separated origins allowed to call POST /v1/widget/chat from a browser.
BT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Serve GET /v1/sessions/{id}/trace (behind BT_API_KEY): true or false.
BT_EXPOSE_TRACES=false
# Secret that signs widget session tokens (secret). Empty: a random secret per process.
BT_SESSION_SECRET=
# Trust X-Forwarded-For for the per-IP rate limit (only behind your own reverse proxy): true or false.
BT_TRUST_PROXY=false
# How long an offered slot list stays bookable, in seconds.
BT_SLOT_TTL_SECONDS=900
# Longest accepted message, in characters.
BT_MAX_INPUT_CHARS=2000
# Turns after which a session ends.
BT_MAX_TURNS_PER_SESSION=40
# URL that receives a POST for every hand-off to a human. Empty: hand-offs are only stored.
BT_HANDOFF_WEBHOOK_URL=

# --- Sandbox and budget -------------------------------------------------------------------------------------

# Bearer token of the sandbox service (every route except GET /_ui requires it).
BT_SANDBOX_TOKEN=sandbox
# Global spend cap in USD across all processes sharing BT_LEDGER_DIR. Empty: no cap.
BT_BUDGET_USD=
# Cost ledger directory; each process appends to its own JSONL file there.
BT_LEDGER_DIR=~/.local/state/booking-truth/ledger
# Price table (YAML) to use instead of the bundled pricing.yaml. Empty: the bundled table.
BT_PRICING_PATH=
